{
    "name": "orbitis/core-contracts",
    "description": "Interfaces e DTOs que o core do Orbitis expõe a módulos e apps. Sem implementação.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Orbitis\\Contracts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Orbitis\\Contracts\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
